# =============================================================================
# CPEE Frontend — Variables de entorno
# =============================================================================
#
# INSTRUCCIONES
# -------------
# 1. Copiá este archivo y renombrá la copia según el entorno:
#      .env.local          → desarrollo local (ignorado por git)
#      .env.development    → desarrollo (tomado por `pnpm dev`)
#      .env.production     → producción  (tomado por `pnpm build`)
#
# 2. TODAS las variables DEBEN empezar con VITE_ para que Vite las
#    exponga en el bundle del cliente.
#
# 3. Nunca subas valores reales de producción al repositorio.
#    Usá este archivo solo con valores de ejemplo / placeholder.
#
# Referencia: https://vitejs.dev/guide/env-and-mode.html
# =============================================================================


# -----------------------------------------------------------------------------
# API — Backend PHP
# -----------------------------------------------------------------------------

# URL base del backend PHP. Sin barra final.
# Todos los servicios en src/api/services/ la usan como baseURL de Axios.
#
# Ejemplos:
#   Desarrollo local (PHP built-in server):  http://localhost:8000/api
#   Staging:                                 https://staging.cpee.org.ar/api
#   Producción:                              https://cpee.org.ar/api
VITE_API_URL=http://localhost:8000/api

# Timeout de las peticiones HTTP en milisegundos.
# Si el servidor no responde en este tiempo, Axios lanza un error de red.
# Default usado por el cliente si se omite esta variable: 30000 (30 s).
VITE_API_TIMEOUT=30000


# -----------------------------------------------------------------------------
# WhatsApp
# -----------------------------------------------------------------------------

# Número de WhatsApp de contacto institucional, SIN el signo +.
# Se usa para construir el enlace https://wa.me/<número> en los componentes de contacto.
#
# Formato: código de país + código de área + número (sin espacios ni guiones)
# Ejemplo Argentina: 54 11 2345-6789 → 5491123456789
VITE_WHATSAPP_NUMBER=5491123456789


# -----------------------------------------------------------------------------
# Modo mock (desarrollo sin API real)
# -----------------------------------------------------------------------------

# Si es "true", todos los hooks de React Query obtienen datos de los archivos
# en src/mocks/data/ en lugar de llamar al backend.
# Ideal para trabajar sin levantar el servidor PHP.
#
# "true"  → usa mocks locales  (recomendado para desarrollo)
# "false" → llama a VITE_API_URL (recomendado para staging/producción)
VITE_USE_MOCKS=true


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Si es "true", el interceptor de Axios imprime los errores de API en la
# consola del navegador (console.error).
# Desactivar en producción para no exponer detalles internos.
#
# "true"  → logs visibles en DevTools
# "false" → modo silencioso
VITE_ENABLE_LOGS=true
